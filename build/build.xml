<?xml version="1.0" encoding="UTF-8"?>
<project name="external-files-in-media-library" basedir="." default="help">

    <!-- Include config file containing  -->
    <loadproperties srcFile="build.properties" />

    <!-- Sets variables, which can later be used. -->
    <property name="src.dir" location="../" />
    <property name="build.dir" location="../releases" />
    <property name="log.dir" location="./" />

    <!-- check for necessary vars -->
    <fail unless="plugin.slug" />
    <fail unless="plugin.version" />
    <fail unless="composer.path" />
    <fail unless="npm.path" />
    <fail message="Do not run as root!">
        <condition>
            <equals arg1="root" arg2="${user.name}"/>
        </condition>
    </fail>

    <!-- install composer -->
    <target name="composer-install">
        <delete file="${log.dir}/composer-install.txt"/>
        <exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/composer-install.txt">
            <arg line="install"/>
        </exec>
    </target>

    <!-- generate documentation -->
    <target name="generate-documentation" depends="composer-install">
        <exec dir="${src.dir}" failonerror="false" executable="vendor/bin/wp-documentor">
            <arg line="parse app --format=markdown --output=docs/hooks.md --prefix=efml_ --exclude=Section.php --exclude=Tab.php --exclude=Import.php --exclude=Export.php --exclude=Field_Base.php --exclude=Settings.php --exclude=Page.php --exclude=Rest.php --exclude=Transients.php" />
        </exec>
    </target>

    <!-- install npm -->
    <target name="npm-install">
        <delete file="${log.dir}/npm-install1.txt"/>
        <delete file="${log.dir}/npm-install2.txt"/>
        <delete file="${log.dir}/npm-install3.txt"/>
        <!-- use "ci" like the GitHub Action, so the versions from package-lock.json are used. -->
        <exec dir="${src.dir}" failonerror="true" executable="${npm.path}" output="${log.dir}/npm-install1.txt">
            <arg line="ci"/>
        </exec>
    </target>

    <!-- build via npm -->
    <target name="npm-build" depends="npm-install">
        <delete file="${log.dir}/npm-build1.txt"/>
        <delete file="${log.dir}/npm-build2.txt"/>
        <delete file="${log.dir}/npm-build3.txt"/>
        <delete file="${log.dir}/npm-build4.txt"/>
        <!-- the complete build, like the GitHub Action: it also copies Driver.js for the intro to admin/driverjs. -->
        <exec dir="${src.dir}" failonerror="true" executable="${npm.path}" output="${log.dir}/npm-build1.txt">
            <arg line="run build"/>
        </exec>
    </target>

    <!-- check WCS compatibility -->
    <target name="check-wcs" depends="composer-install">
        <exec dir="${src.dir}" failonerror="false" executable="vendor/bin/phpcbf">
            <arg line="."/>
        </exec>
        <exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpcs">
            <arg line="."/>
        </exec>
    </target>

    <!-- check PHPStan -->
    <target name="check-phpstan" depends="composer-install">
        <exec dir="${src.dir}" failonerror="false" executable="vendor/bin/phpstan">
            <arg line="analyse"/>
        </exec>
    </target>

    <!-- generate the autoloader for release -->
    <target name="autoloader-generation">
        <delete file="${log.dir}/autoloader-generation.txt"/>
        <exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/autoloader-generation.txt">
            <arg line="dump-autoload -oa --no-dev"/>
        </exec>
    </target>

    <!-- generate the autoloader for development -->
    <target name="autoloader-generation-dev">
        <delete file="${log.dir}/autoloader-generation-dev.txt"/>
        <exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/autoloader-generation-dev.txt">
            <arg line="dump-autoload -oa"/>
        </exec>
    </target>

    <!-- check PHPCompatibility -->
    <target name="check-php-compatibility" depends="composer-install">
        <exec dir="${src.dir}" failonerror="false" executable="vendor/bin/phpcs">
            <arg line="-p app --standard=PHPCompatibilityWP"/>
        </exec>
    </target>

    <!-- PHP Unit Tests -->
    <target name="php-unit-tests" depends="composer-install">
        <delete file="${log.dir}/php-unit-tests-1.txt"/>
        <delete file="${log.dir}/php-unit-tests-2.txt"/>
        <exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/php-unit-tests-1.txt">
            <arg line="test-install-during-build"/>
        </exec>
        <!-- start the FTP, FTPS and SFTP servers for the tests. Without them (e.g. missing Python modules or as root) these tests are skipped. -->
        <exec dir="${src.dir}" failonerror="false" executable="bash">
            <arg line="bin/test-servers.sh start"/>
        </exec>
        <exec dir="${src.dir}" failonerror="false" executable="${composer.path}" output="${log.dir}/php-unit-tests-2.txt" resultproperty="php-unit-tests.result">
            <arg line="test"/>
        </exec>
        <!-- stop the servers, also if tests failed. -->
        <exec dir="${src.dir}" failonerror="false" executable="bash">
            <arg line="bin/test-servers.sh stop"/>
        </exec>
        <fail message="PHP Unit Tests failed, see ${log.dir}/php-unit-tests-2.txt">
            <condition>
                <not>
                    <equals arg1="${php-unit-tests.result}" arg2="0"/>
                </not>
            </condition>
        </fail>
    </target>

    <!-- init project -->
    <target name="init" description="Initialize the project" depends="composer-install,autoloader-generation-dev,npm-build" />

    <!-- create the release-zip with the same script as the GitHub Action "Build release zip" (used by "release-zip" and "build") -->
    <target name="create-release-zip">
        <delete file="${build.dir}/${plugin.slug}_${plugin.version}.zip"/>

        <!-- install the PHP packages without dev packages and generate the release autoloader -->
        <exec dir="${src.dir}" failonerror="true" executable="bash">
            <env key="RELEASE_SLUG" value="${plugin.slug}"/>
            <env key="COMPOSER_BIN" value="${composer.path}"/>
            <arg line="bin/build-release.sh prepare"/>
        </exec>

        <!-- collect the files of the release in dist/ and set the version number -->
        <exec dir="${src.dir}" failonerror="true" executable="bash">
            <env key="RELEASE_SLUG" value="${plugin.slug}"/>
            <env key="COMPOSER_BIN" value="${composer.path}"/>
            <arg value="bin/build-release.sh"/>
            <arg value="collect"/>
            <arg value="${plugin.version}"/>
        </exec>

        <!-- create the zip -->
        <exec dir="${src.dir}" failonerror="true" executable="bash">
            <env key="RELEASE_SLUG" value="${plugin.slug}"/>
            <env key="COMPOSER_BIN" value="${composer.path}"/>
            <arg value="bin/build-release.sh"/>
            <arg value="zip"/>
            <arg value="${build.dir}/${plugin.slug}_${plugin.version}.zip"/>
        </exec>

        <!-- get the dev packages back for development -->
        <exec dir="${src.dir}" failonerror="true" executable="bash">
            <env key="COMPOSER_BIN" value="${composer.path}"/>
            <arg line="bin/build-release.sh restore"/>
        </exec>
        <antcall target="autoloader-generation-dev" />
    </target>

    <!-- create only the release-zip, without tests and checks -->
    <target name="release-zip" description="Creates the release-zip without tests and checks" depends="init">
        <antcall target="create-release-zip" />
    </target>

    <!-- create release-zip -->
    <target name="build" description="Builds a new release" depends="init,generate-documentation,php-unit-tests,check-phpstan,check-php-compatibility,check-wcs">
        <!-- the checks above need the dev packages, so the release-zip is created afterwards -->
        <antcall target="create-release-zip" />
    </target>

    <target name="help">
        <java classname="org.apache.tools.ant.Main">
            <arg value="-projecthelp" />
            <arg value="-buildfile" />
            <arg value="build.xml" />
        </java>
    </target>

</project>
