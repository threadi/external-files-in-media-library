<?xml version="1.0"?>
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
        bootstrap="tests/bootstrap.php"
        colors="true"
        convertDeprecationsToExceptions="true"
>
    <testsuites>
        <testsuite name="testing">
            <directory suffix=".php">./tests/Unit/</directory>
            <!-- run the uninstallation as last test: it defines EFML_DEINSTALLATION_RUNNING, which changes the behavior for the rest of the process. -->
            <exclude>./tests/Unit/Scenarios/Uninstall.php</exclude>
            <file>./tests/Unit/Scenarios/Uninstall.php</file>
        </testsuite>
    </testsuites>
</phpunit>
