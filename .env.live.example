# Live tests of External Files in Media Library with real accounts.
#
# Copy this file to ".env.live" (never commit it, it is in .gitignore) or set the path to your file in the
# environment variable EFML_LIVE_ENV. Only the services with all required keys are tested, the others are skipped.
# See docs/live-tests.md for details.
#
# Format: KEY=value, one per line. Values could be quoted with " or '. Lines starting with # are comments.
# Keys ending with _FILE read their value from the given file, e.g. for JSON (KEY_FILE=/path/to/file.json sets KEY).
#
# Use separate test accounts, buckets or folders: the tests upload, import and delete files there.

# ---------------------------------------------------------------------------------------------------------------------
# General settings
# ---------------------------------------------------------------------------------------------------------------------

# Source of the extensions for "composer test-install-live": "none", "github" or a directory with your working copies
# side by side (e.g. /home/me/repos, containing external-files-from-aws-s3 etc.). Default: github.
#EFML_ADDONS_SOURCE=github
# Branch, tag or commit on GitHub (default: master).
#EFML_ADDONS_REF=master
# Per extension (AWS, GCS, DRIVE, WEBDAV): source and reference, e.g. a working copy for one and GitHub for the others.
#EFML_ADDON_AWS_SOURCE=/home/me/repos/external-files-from-aws-s3
#EFML_ADDON_DRIVE_REF=master

# Maximum number of files in the directory of an external source for the test of the synchronization (default: 20).
# Larger directories are not synchronized during the tests.
#EFML_LIVE_MAX_SYNC_FILES=20

# Single URLs, which are imported via "Add URL" (comma separated), e.g. a public image, a Dropbox shared link,
# a YouTube or Vimeo video.
#EFML_LIVE_URLS=https://example.com/image.jpg,https://www.dropbox.com/scl/fi/.../image.jpg?rlkey=...&dl=0

# Allow requests to servers in the local network, e.g. MinIO or a WebDAV server in a container (1 = allowed).
# WordPress blocks them otherwise as unsafe URLs.
#EFML_LIVE_ALLOW_LOCAL_HOSTS=1

# Services whose external source allows only private files (e.g. a bucket with "Block public access"), separated by
# commas: their public export is skipped, the other tests export privately. Example: aws-s3,google-cloud-storage
#EFML_LIVE_PRIVATE_ONLY=

# Accept self-signed certificates, e.g. of a WebDAV server in a container (1 = accepted). Only for test servers!
#EFML_LIVE_IGNORE_SSL=1

# ---------------------------------------------------------------------------------------------------------------------
# Playwright live tests (composer test-live-e2e): your development website with the plugin "EFML Dev Credentials"
# ---------------------------------------------------------------------------------------------------------------------

#EFML_LIVE_SITE_URL=https://efml.local
#EFML_LIVE_SITE_ADMIN_USER=admin
#EFML_LIVE_SITE_ADMIN_PASSWORD=
# Optional: an editor to test the export of his uploads (best without the capabilities for the services).
#EFML_LIVE_SITE_EDITOR_USER=
#EFML_LIVE_SITE_EDITOR_PASSWORD=
# Browser of the Playwright tests: empty for the browser of Playwright ("npx playwright install chromium"),
# "chrome" for the installed Google Chrome.
#EFML_LIVE_BROWSER_CHANNEL=chrome

# ---------------------------------------------------------------------------------------------------------------------
# Services of External Files in Media Library
# ---------------------------------------------------------------------------------------------------------------------

# Local directory (no credentials). The directory is imported, exported files are saved there.
#EFML_LIVE_LOCAL_DIRECTORY=/var/www/efml-live/
# Public URL of this directory, required for the export.
#EFML_LIVE_LOCAL_PUBLIC_URL=https://efml.local/efml-live/

# FTP, FTPS or SFTP: the protocol is part of the server (ftp://, ftps:// or sftp://), the path is the directory.
#EFML_FTP_SERVER=ftps://ftp.example.com/efml-live/
#EFML_FTP_LOGIN=
#EFML_FTP_PASSWORD=
# Public URL of this directory, required for the export (not possible with SFTP).
#EFML_LIVE_FTP_PUBLIC_URL=https://files.example.com/efml-live/

# Dropbox: your Dropbox app (preferably with access to its app folder only) and a refresh token of a connection
# (the plugin "EFML Dev Credentials" shows it on a website connected with Dropbox).
#EFML_DROPBOX_API_KEY=
#EFML_DROPBOX_API_SECRET=
#EFML_LIVE_DROPBOX_REFRESH_TOKEN=

# WordPress REST API of another website (import only).
#EFML_REST_SERVER=https://example.com
#EFML_REST_LOGIN=
#EFML_REST_PASSWORD=

# ZIP file (import only).
#EFML_ZIP_SERVER=https://example.com/files.zip
#EFML_ZIP_LOGIN=
#EFML_ZIP_PASSWORD=
#EFML_ZIP_ZIP_PASSWORD=

# CSV and XML lists with URLs (import only).
#EFML_CSV_LIST_URL=https://example.com/list.csv
#EFML_CSV_LOGIN=
#EFML_CSV_PASSWORD=
#EFML_XML_LIST_URL=https://example.com/list.xml
#EFML_XML_LOGIN=
#EFML_XML_PASSWORD=

# YouTube channel (import only).
#EFML_YOUTUBE_CHANNEL_ID=
#EFML_YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# Extension "External Files from AWS S3": AWS S3 and other S3-compatible platforms
# ---------------------------------------------------------------------------------------------------------------------

#EFML_AWS_S3_ACCESS_KEY=
#EFML_AWS_S3_SECRET=
#EFML_AWS_S3_BUCKET=
#EFML_AWS_S3_REGION=eu-central-1
#EFML_AWS_S3_CLOUDFRONT_DOMAIN=
#EFML_AWS_S3_CLOUDFRONT_DISTRIBUTION_ID=

#EFML_CLOUDFLARE_R2_ACCOUNT_ID=
#EFML_CLOUDFLARE_R2_ACCESS_KEY=
#EFML_CLOUDFLARE_R2_SECRET=
#EFML_CLOUDFLARE_R2_BUCKET=
#EFML_CLOUDFLARE_R2_EU=0
#EFML_CLOUDFLARE_R2_PUBLIC_DOMAIN=

#EFML_BACKBLAZE_S3_ACCESS_KEY=
#EFML_BACKBLAZE_S3_SECRET=
#EFML_BACKBLAZE_S3_BUCKET=
#EFML_BACKBLAZE_S3_REGION=eu-central-003
#EFML_BACKBLAZE_S3_PUBLIC_DOMAIN=

#EFML_DIGITAL_OCEAN_SPACES_ACCESS_KEY=
#EFML_DIGITAL_OCEAN_SPACES_SECRET=
#EFML_DIGITAL_OCEAN_SPACES_BUCKET=
#EFML_DIGITAL_OCEAN_SPACES_REGION=fra1
#EFML_DIGITAL_OCEAN_SPACES_PUBLIC_DOMAIN=

# S3-compatible storage with own endpoint (e.g. MinIO).
#EFML_S3_COMPATIBLE_ENDPOINT=https://minio.example.com
#EFML_S3_COMPATIBLE_REGION=us-east-1
#EFML_S3_COMPATIBLE_ACCESS_KEY=
#EFML_S3_COMPATIBLE_SECRET=
#EFML_S3_COMPATIBLE_BUCKET=
#EFML_S3_COMPATIBLE_PATH_STYLE=1
#EFML_S3_COMPATIBLE_PUBLIC_URL=
#EFML_S3_COMPATIBLE_CHECKSUM_WHEN_REQUIRED=1

#EFML_HETZNER_OBJECT_STORAGE_REGION=fsn1
#EFML_HETZNER_OBJECT_STORAGE_ACCESS_KEY=
#EFML_HETZNER_OBJECT_STORAGE_SECRET=
#EFML_HETZNER_OBJECT_STORAGE_BUCKET=

#EFML_IONOS_OBJECT_STORAGE_REGION=eu-central-3
#EFML_IONOS_OBJECT_STORAGE_ACCESS_KEY=
#EFML_IONOS_OBJECT_STORAGE_SECRET=
#EFML_IONOS_OBJECT_STORAGE_BUCKET=

#EFML_OVHCLOUD_OBJECT_STORAGE_REGION=de
#EFML_OVHCLOUD_OBJECT_STORAGE_ACCESS_KEY=
#EFML_OVHCLOUD_OBJECT_STORAGE_SECRET=
#EFML_OVHCLOUD_OBJECT_STORAGE_BUCKET=

#EFML_SCALEWAY_OBJECT_STORAGE_REGION=fr-par
#EFML_SCALEWAY_OBJECT_STORAGE_ACCESS_KEY=
#EFML_SCALEWAY_OBJECT_STORAGE_SECRET=
#EFML_SCALEWAY_OBJECT_STORAGE_BUCKET=

#EFML_WASABI_REGION=eu-central-1
#EFML_WASABI_ACCESS_KEY=
#EFML_WASABI_SECRET=
#EFML_WASABI_BUCKET=

# ---------------------------------------------------------------------------------------------------------------------
# Extension "External Files from Google Cloud Storage"
# ---------------------------------------------------------------------------------------------------------------------

# The JSON key of the service account, preferably as file.
#EFML_GOOGLE_CLOUD_STORAGE_AUTHENTICATION_JSON_FILE=/path/to/service-account.json
#EFML_GOOGLE_CLOUD_STORAGE_BUCKET=

# ---------------------------------------------------------------------------------------------------------------------
# Extension "External Files from Google Drive"
# ---------------------------------------------------------------------------------------------------------------------

# Refresh token of a connection (the plugin "EFML Dev Credentials" shows it on a website connected with Google Drive).
#EFML_LIVE_GOOGLE_DRIVE_REFRESH_TOKEN=
# Only if the connection uses your own OAuth client.
#EFML_GOOGLE_DRIVE_CLIENT_ID=
#EFML_GOOGLE_DRIVE_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# Extension "External Files from WebDAV"
# ---------------------------------------------------------------------------------------------------------------------

#EFML_WEBDAV_SERVER=https://cloud.example.com
#EFML_WEBDAV_LOGIN=
#EFML_WEBDAV_PASSWORD=
# Path to the WebDAV directory, e.g. for Nextcloud /remote.php/dav/files/ (the login is added).
#EFML_WEBDAV_PATH=
